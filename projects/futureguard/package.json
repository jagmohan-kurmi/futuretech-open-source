{
  "name": "@jagmohan-kurmi/futureguard",
  "version": "0.1.0",
  "description": "AI-generated code security scanner with severity-based findings and report exports",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
